 "poems": [
  {
   "seq": "1",
   "text": "朝きりに道はまとひぬたつた川いつれの程か渡りなるらん",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "秋くれはいとよりかくる萩の枝はむらこに花そ咲みたれける",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "春はまつ我しめ置しみやきのゝ小萩に秋は花咲にけり",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "色に出て猶むつましき女郞花こと花よりもなつかしきかな",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "女郞花猶なつかしみ思へとも我ひとりのみしぬそかひなき",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "くる人もなき山里にあさゆふは鹿の音のみそ耳なれにける",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "秋ことにくる初雁の聲きゝてあはれといはぬ旅のなきかな",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "ふる里やおもひいつらむ雁金はさよふけかたに鳴わたるなり",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "かくながら消せさりせは白露を秋のかたみに置てみてまし",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "朝またきおきてしみれは竹の葉によをこめてこそ露は置けれ",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "秋よりももふてしにける紅葉はを尋ねぬ人はまたやみさらん",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "立田姫たつたの山の紅葉はをしくれて又も染てけるかな",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "ま葛はふをのゝ篠原したにのみ人をこふるはくるしかりけり",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "身の上になるへき事もしらるかは戀せし人をもとかさらまし",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "君が代はから吳藍の深き色にやちとせつはき紅葉するまて",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "君か代はかそへやるへきかたもなし濱の眞砂を數にとるとも",
   "kana": "",
   "speaker": "",
   "page": 475,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
